node_modules/
dist/
.env
.env.*
!.env.example
*.log
# AI embedding 本地缓存（不含密钥）
.ai-embeddings.cache.json

# 验收产物（截图与报告）
.artifacts/

# 本机测试样本目录（转场/动效草案的 HTML 预览，含本地图片，不属于正式工程）
/testdemo/

# 压缩包（素材打包/转存用，动辄数百 MB，绝不进库；发给组员的产物走 _deliver/）
*.zip

# 本机工具链临时目录
.npm-cache/
.acl-recovery/

# 本机 AI IDE（Qoder）的插件配置与技能缓存
/.qoder/

# DSH 在工程内落的工具产物（ACL 修复备份/报告等）
/.dsh/

# 素材探索阶段生成的概念图/拆解图（piying-parts-sheet 等），不属于正式素材
/vibe_images/

# 临时网络/音频探测脚本（与工程无关的本机排查工具）
/_probe_*

# 下发给组员的打包产物
_deliver/

# 素材（603 MB / 410 文件）：物理放在工程内，保证「拷文件夹即可运行」，
# 但绝不进 git（会让仓库膨胀到 GB 级）。首次使用请放入 assets/images，
# 或用 scripts/extract-assets.ps1 从源工程 zip 一键抽取。
/assets/images/*
!/assets/images/.gitkeep

# MediaPipe 运行时姿态模型（44MB，来自 testdemo/CV），用 scripts/copy-piying-assets.ps1 重建
/public/cv/vendor/

