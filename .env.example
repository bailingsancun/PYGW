# 复制本文件为 .env.local 并填入真实口令。.env.local 绝不提交、绝不放进 VITE_*。
# 只有 VITE_ 前缀的变量会进入浏览器构建，因此这里不含任何密钥。

# --- shim 连库（服务端专用，绝不加 VITE_ 前缀）---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=deepseek
DB_PASSWORD=
DB_NAME=deepseek

# shim 监听地址与端口（开发期由 Vite 的 /api 代理转发过来）
SHIM_HOST=127.0.0.1
SHIM_PORT=8787
# 0 = 不放行跨域（默认，生产同源部署/Vite 代理都不需要 CORS）；
# 仅开发期需要跨域直连调试时设 1（只读 GET、无凭据）
SHIM_CORS=0

# --- 素材目录（可选覆盖，一般不用填）---
# 默认直接使用工程内的 assets/images，工程即自包含，无需配置。
# 仅当你把素材放在工程外时才启用：
# ASSET_ROOT=D:\某个位置\images
#
# 解析优先级：工程内 assets/images（存在时最高） > 本项的 ASSET_ROOT > 工程内路径。
# 首次使用若 assets/images 为空，运行 scripts\extract-assets.ps1 从源工程 zip 抽取。

# --- 前端开发服务器 ---
VITE_API_BASE_URL=/api/v1
WEB_PORT=5173

# --- AI 讲解员 / RAG / 多模态（服务端专用，可选；缺失时自动回落展馆静态资料）---
# 首次运行 启动本地演示.bat 或 npm run setup 会交互填写。
# base_url 含版本前缀；协议格式 chat=OpenAI兼容 / message=Anthropic / response=OpenAI新
AI_BASE_URL=
AI_API_KEY=
AI_FORMAT=chat
AI_MODEL=
AI_HOST=127.0.0.1
AI_PORT=8788
# Agent 工具规划最大轮数（1-8）；chat 协议走模型 Function Calling，其余协议/未配置走规则规划
AI_AGENT_MAX_STEPS=3
# 限流：每分钟每 IP 的 LLM 请求上限（0=关闭；默认 20），作用于 /ask /narrate /agent /vision /quiz
AI_RATE_LIMIT=20
# 全局每日 LLM 请求总额度（0=关闭；默认 1000），跨所有 IP 的熔断，按服务器本地日期跨天归零
AI_GLOBAL_DAILY_LIMIT=1000
# 限流来源 IP：0=用 socket IP（默认，防 X-Forwarded-For 伪造绕过限流）；
# 仅部署在可信反代后（如本工程 static-server）才设 1，此时取 X-Forwarded-For 首段
AI_TRUST_PROXY=0
# 跨源白名单（逗号分隔，如 https://your.site）；同源部署/Vite 代理无需配置
AI_ALLOWED_ORIGINS=
# 可选 embedding（不填则检索用关键词+metadata）；base_url 同样含版本前缀
AI_EMBEDDING_BASE_URL=
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_MODEL=

# 多模态识图（/api/ai/vision）需 AI_FORMAT=chat 且模型支持视觉（如 gpt-4o / qwen-vl-max / glm-4v）；
# 否则自动回落「皮影赏析四看」+ 展馆资料，前端永不死端。

# --- AI 图片转皮影（身入影幕 · 幕后入口；服务端专用，可选）---
# 兼容 OpenAI /images/generations 协议的图像生成服务。
# 三项都填才会真正调用图像模型；否则前端用本地「皮影合成器」生成，功能仍可用但界面会标注来源。
# 提示词约束来自 .qoder/skills/piying-pipeline/references/prompts.md。
PIYING_IMAGE_BASE_URL=
PIYING_IMAGE_API_KEY=
PIYING_IMAGE_MODEL=
# 生成尺寸：快速模式用它；精致模式的零件图固定用 1536x1536
PIYING_IMAGE_SIZE=1024x1024
