# 复制本文件为 .env.local 并填入真实口令。.env.local 绝不提交、绝不放进 VITE_*。
# 只有 VITE_ 前缀的变量会进入浏览器构建，因此这里不含任何密钥。

# --- shim 连库（服务端专用，绝不加 VITE_ 前缀）---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=deepseek
DB_PASSWORD=
DB_NAME=deepseek

# shim 监听地址与端口（开发期由 Vite 的 /api 代理转发过来）
SHIM_HOST=127.0.0.1
SHIM_PORT=8787
# 1 = 允许跨域直连调试（只读 GET、无凭据）；生产同源部署可设为 0
SHIM_CORS=1

# --- 静态素材挂载源（指向源工程，只读，不要复制 604 MB）---
ASSET_ROOT=D:\聚萤分享\Cloud-Shadow-组员演示开发包-2026-08-03\storage\assets\legacy-import\images

# --- 前端开发服务器 ---
VITE_API_BASE_URL=/api/v1
WEB_PORT=5173
